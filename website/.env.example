# Server-only. Copy to .env.local; never commit real credentials.
APP_URL=http://localhost:3000
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_BUSINESS_ID=
DODO_PAYMENTS_WEBHOOK_KEY=
# Generate with: openssl rand -hex 32
DODO_PAYMENTS_CHECKOUT_SECRET=

# Each product must have a License Key entitlement attached.
# Recurring products: 1 month, 3 months, 1 year; Lifetime: one-time payment.
DODO_PAYMENTS_PRODUCT_MONTHLY=
DODO_PAYMENTS_PRODUCT_QUARTERLY=
DODO_PAYMENTS_PRODUCT_YEARLY=
DODO_PAYMENTS_PRODUCT_LIFETIME=

# Comma-separated Chrome extension IDs (including your unpacked test ID).
CHROME_EXTENSION_IDS=
