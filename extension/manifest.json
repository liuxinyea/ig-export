{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extensionName__",
  "version": "0.1.0",
  "description": "__MSG_extensionDescription__",
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/free-ig-export-16.png",
      "32": "icons/free-ig-export-32.png",
      "64": "icons/free-ig-export-64.png",
      "128": "icons/free-ig-export-128.png"
    }
  },
  "icons": {
    "16": "icons/free-ig-export-16.png",
    "32": "icons/free-ig-export-32.png",
    "64": "icons/free-ig-export-64.png",
    "128": "icons/free-ig-export-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "storage",
    "downloads",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.instagram.com/*"
  ],
  "optional_host_permissions": [
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*",
    "https://igexport.auraflame.tech/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "i18n/*.json"
      ],
      "matches": [
        "https://www.instagram.com/*"
      ]
    }
  ],
  "minimum_chrome_version": "102"
}
